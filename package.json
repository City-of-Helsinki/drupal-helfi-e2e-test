{
  "name": "drupal-helfi-e2e-test",
  "description": "E2E test base for instance specific tests",
  "version": "0.0.2",
  "license": "MIT",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:headed:slow": "SLOWMO=true npx playwright test --headed",
    "lint:js": "biome lint --fix utils/ tests/",
    "format:js": "biome format --fix utils/ tests/",
    "postinstall": "node scripts/precommit-hook.js"
  },
  "directories": {
    "test": "tests"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@dotenvx/dotenvx": "^1.15.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.0",
    "ts-node": "^10.9.0"
  }
}
