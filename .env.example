# Multi-Site E2E Test Configuration
# Copy this file to .env and configure for your local environment

# ============================================================================
# SITE-SPECIFIC CONFIGURATION
# ============================================================================
# For each site defined in sites.config.ts, set the BASE_URL using the pattern:
# {ENV_PREFIX}_BASE_URL=https://your-site.docker.so

# Etusivu
ETUSIVU_BASE_URL=https://helfi-etusivu.docker.so

# Add additional sites as needed:
# ASUMINEN_BASE_URL=https://helfi-asuminen.docker.so

# ============================================================================
# GLOBAL CONFIGURATION
# ============================================================================

# Override storage state directory (optional)
# By default, uses XDG_RUNTIME_DIR, TMPDIR, or OS temp directory
# STORAGE_STATE_DIR=/custom/path

# Enable slow motion for headed tests (1 second delay between actions)
# Used by: npm run test:headed:slow
# SLOWMO=true

# CI mode (enables 2 retries on test failure)
# CI=true
